<launch>

    <!-- *****GPT生成版***** 启动 amcl 节点 -->
    <node name="amcl_node" pkg="amcl" type="amcl" output="screen">
        <param name="use_sim_time" value="false"/>
        
        <!-- 地图服务器参数 -->
        <rosparam command="load" file="$(find your_package)/your_map.yaml"/> <!-- 将 'your_package' 替换为包含 your_map.yaml 的包名称 -->
        <param name="map_frame" value="map"/>
        <param name="publish_tf" value="true"/>
        
        <!-- 定位参数 -->
        <param name="odom_frame_id" value="odom"/>
        <param name="odom_model_type" value="diff-corrected"/> <!-- 设置机器人模型为差速轮模型 -->
        <param name="base_frame_id" value="base_link"/>
        <param name="global_frame_id" value="map"/>
        <param name="use_map_topic" value="true"/>
        <param name="map_topic" value="/map"/> <!-- 将 /map 替换为你实际发布的地图话题 -->

        <!-- 传感器参数 -->
        <param name="transform_tolerance" value="0.1"/>
        <param name="gui_publish_rate" value="10"/>

        <!-- 更新参数 -->
        <param name="min_particles" value="100"/>
        <param name="max_particles" value="500"/>
        <param name="update_min_d" value="0.1"/>
        <param name="update_min_a" value="0.05"/>
        
        <!-- 初始姿态参数 -->
        <param name="initial_pose_x" value="0.0"/>
        <param name="initial_pose_y" value="0.0"/>
        <param name="initial_pose_a" value="0.0"/> <!-- 根据需要设置初始姿态 -->

        <!-- Move Base 参数 -->
        <!-- 添加任何其他必要的 move_base 参数 -->
    </node>
</launch>

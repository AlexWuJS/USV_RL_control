<launch>

	<!-- 标签  默认使用gmapping算法进行建图 -->
	<arg name="slam_methods" default="gmapping" />

	<!-- 启动船的包含底盘，雷达设备 -->
	<include file="$(find USV_ship)/launch/bringup.launch" >
		<arg name="use_pose_ekf"      value="true"/>
		<arg name="use_lidar"         value="true"/>
	</include>

	<!-- 建图算法: Gmapping, Cartographer, Hector, Karto -->
	<include file="$(find USV_nav)/launch/gmapping.launch"/>

</launch>

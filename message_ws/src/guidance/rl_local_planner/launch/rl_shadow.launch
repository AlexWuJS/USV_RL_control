<launch>
  <!-- RL Shadow 模式：只接收观测、计算并记录 RL 指令，不参与控制。
       前提：实艇正常按 a_star_demo.launch（huamo LOS）航行。
       用法：
         roslaunch rl_local_planner rl_shadow.launch
         roslaunch rl_local_planner rl_shadow.launch model_path:=/path/to/actor.pt -->
  <arg name="mode" default="shadow"/>
  <arg name="model_path" default=""/>

  <node pkg="rl_local_planner" type="rl_local_planner_node.py" name="rl_local_planner" output="screen">
    <rosparam file="$(find rl_local_planner)/config/rl_planner.yaml" command="load"/>
    <param name="node/mode" value="$(arg mode)"/>
    <param name="node/model_path" value="$(arg model_path)"/>
  </node>
</launch>

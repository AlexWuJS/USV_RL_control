# RL测试四阶段启动命令

# 阶段0 纯规划练习（桨不动）：
roslaunch a_star_planner water_test.launch use_controller:=false

# 阶段1 基线（LOS + shadow + 开环）：
roslaunch a_star_planner water_test.launch

# 阶段2 速度闭环 B 趟：
roslaunch a_star_planner water_test.launch use_pose_speed_diff:=true

# 阶段3 RL 闭环第一级（终端2）：
roslaunch a_star_planner water_test.launch guidance_mode:=rl rl_mode:=none use_pose_speed_diff:=true
# 终端3（RL 执令）：
roslaunch rl_local_planner rl_guidance.launch model_path:=/home/jetson/haique/little-boat-motion-control/message_ws/src/guidance/rl_local_planner/models/stage2_best_actor.pt
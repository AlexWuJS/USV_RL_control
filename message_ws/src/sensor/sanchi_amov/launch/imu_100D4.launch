<?xml version="1.0"?>
<launch>
  <node pkg="sanchi_amov"
        name="imu"
        type="sanchi_amov"
        output="screen">
    <param name="port" value="/dev/imu"/>
    <param name="model" value="100D4"/>
    <param name="baud" value="115200"/>
    <param name="frame_id" value="imu"/>    <!-- 若修改，需要catkin_make -->
  </node>

</launch>

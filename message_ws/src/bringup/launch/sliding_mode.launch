<launch>
    <!-- 启用机器人 -->
    <include file="$(find bringup)/launch/bringup.launch">
        <arg name="use_imu"         default="false"/>
        <arg name="use_rtk"         default="false"/>
        <arg name="use_lidar"       default="true"/>
    </include>

    <!-- 生成路径 -->
    <!-- <include file="$(find path)/launch/path.launch">
        <arg name="path_type"         default="square_node"/>
    </include> -->

    <!-- 启用滑模控制 -->
    <node pkg="huamo" type="huamo_node" name="huamo" output="screen">
        <!-- 让 huamo 订阅 A* 输出的 /waypoints_path -->
        <remap from="my_path" to="/waypoints_path" />
    </node>

</launch>
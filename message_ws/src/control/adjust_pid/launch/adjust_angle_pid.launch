<launch>
    <arg name="kp_u" default="0.0" />
    <arg name="ki_u" default="0.0" />
    <arg name="kd_u" default="0.0" />
    <arg name="maxIntegral" default="800.0" />
    <arg name="maxOutput" default="1800.0" />

    <node pkg="adjust_pid" type="adjust_angle_pid_node" name="adjust_angle_pid_node" output="screen">
        <param name="kp_u" value="$(arg kp_u)" />
        <param name="ki_u" value="$(arg ki_u)" />
        <param name="kd_u" value="$(arg kd_u)" />
        <param name="maxIntegral" value="$(arg maxIntegral)" />
        <param name="maxOutput" value="$(arg maxOutput)" />

    </node>

    <node pkg="usart" type="usart_node" name="usart" output="screen"/>
    <node pkg="tcp" type="tcp_node" name="tcp" output="screen"/>

    <!-- <include file="$(find /sanchi_amov)/launch/imu_100D4.launch"/> -->
</launch>
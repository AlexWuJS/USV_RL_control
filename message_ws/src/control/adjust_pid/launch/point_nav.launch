<launch>
    <arg name="angle_kp" default="20.0" />
    <arg name="angle_ki" default="0.0" />
    <arg name="angle_kd" default="125.0" />
    <arg name="location_kp" default="-60.0" />
    <arg name="location_ki" default="0.0" />
    <arg name="location_kd" default="0.0" />
    <arg name="maxIntegral" default="800.0" />
    <arg name="maxOutput" default="1800.0" />

    <include file="$(find bringup)/launch/bringup.launch">
        <arg name="use_imu"         default="true"/>
        <arg name="use_rtk"         default="true"/>
        <arg name="use_lidar"       default="false"/>
    </include>

    <node pkg="adjust_pid" type="point_nav_node" name="point_nav" output="screen">
        <param name="angle_kp" value="$(arg angle_kp)" />
        <param name="angle_ki" value="$(arg angle_ki)" />
        <param name="angle_kd" value="$(arg angle_kd)" />
        <param name="location_kp" value="$(arg location_kp)" />
        <param name="location_ki" value="$(arg location_ki)" />
        <param name="location_kd" value="$(arg location_kd)" />
        <param name="maxIntegral" value="$(arg maxIntegral)" />
        <param name="maxOutput" value="$(arg maxOutput)" />
    </node>

</launch>